# Agent Zero Configuration
# GroqCloud API Key (https://console.groq.com/keys)
GROQ_API_KEY=
# Legacy / Alternative LLM API Key (or OpenAI Compatible)
FREE_LLM_API_KEY=
# Optional Google Gemini API Key
GEMINI_API_KEY=

# Ethereum / EVM Web3 RPC Provider (Optional - falls back to public high-availability RPCs)
WEB3_PROVIDER_URL=https://eth.llamarpc.com

# Agent Ethereum Wallet Address (Optional if AGENT_PRIVATE_KEY is set)
AGENT_WALLET_ADDRESS=

# Agent Private Key (hex string 0x... for Ethereum USDC wallet)
AGENT_PRIVATE_KEY=

# Creator / Owner Wallet Address
CREATOR_WALLET_ADDRESS=

# State and ledger paths
STATE_FILE_PATH=./data/agent_state.json
ACCOUNTING_FILE_PATH=./data/accounting.json
BUSINESS_FILE_PATH=./data/business_profile.json
