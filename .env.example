# ==========================================
# AGENT ZERO - RAILWAY & POLYGON CONFIGURATION
# ==========================================

# 1. PRIMARY BLOCKCHAIN (POLYGON PoS)
# -----------------------------------
# Primary active chain for transactions, gas, and survival economy
PRIMARY_CHAIN=polygon

# Polygon RPC Endpoint (Leave blank to use built-in public failover RPCs or provide Alchemy/Infura/Quicknode)
POLYGON_RPC_URL=https://polygon-rpc.com

# Agent Polygon Private Key (0x... 64-character hex key for signing on-chain transactions & tribute payments)
AGENT_PRIVATE_KEY=

# Agent Public Address (Optional if AGENT_PRIVATE_KEY is set, auto-derived)
AGENT_WALLET_ADDRESS=

# Creator / Owner Wallet Address on Polygon (Receives tribute payments)
CREATOR_WALLET_ADDRESS=

# 2. UI AUTHENTICATION & SECURITY (RAILWAY PUBLIC DOMAIN)
# -------------------------------------------------------
# Protects your public Railway deployment URL against unauthorized access
UI_USERNAME=admin
UI_PASSWORD=

# 3. LLM & REASONING INFERENCE
# ----------------------------
# GroqCloud API Key for fast agentic reasoning (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: Alternative OpenAI-compatible or Google Gemini API Key
GEMINI_API_KEY=
FREE_LLM_API_KEY=

# 4. RAILWAY PERSISTENT STORAGE VOLUME
# ------------------------------------
# Directory path for persistent data volume (mount /data in Railway volume settings)
RAILWAY_VOLUME_MOUNT_PATH=/data
DATA_DIR=/data

# State and ledger file paths (automatically managed in DATA_DIR if unset)
STATE_FILE_PATH=
ACCOUNTING_FILE_PATH=
BUSINESS_FILE_PATH=

